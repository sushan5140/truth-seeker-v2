GEMINI_API_KEY=your_key_here

# Provider-neutral model routing. All are optional; TRUTHSEEKER_VERIFIER_MODEL
# is what NemotronVerifier reads to select an OpenRouter-hosted model. Leaving
# it (or OPENROUTER_API_KEY) unset keeps Gemini as the active verifier.
TRUTHSEEKER_REASONING_MODEL=
TRUTHSEEKER_VERIFIER_MODEL=
TRUTHSEEKER_EMBEDDING_MODEL=
TRUTHSEEKER_RERANKER_MODEL=

# OpenRouter (Phase 2). Both must be set for NemotronVerifier to activate.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
