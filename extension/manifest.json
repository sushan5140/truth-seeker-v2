{
  "manifest_version": 3,
  "name": "Truth & Tone Guardian",
  "version": "2.0.0",
  "description": "Local claim checking and real-time respectful tone suggestions for Microsoft Edge and Chrome.",
  "permissions": ["activeTab", "storage", "scripting", "tabCapture", "offscreen"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "Truth & Tone Guardian",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["settings.js", "content.js", "claim-content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
